---
import { contact } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="container contact">
    <div class="contact__intro" data-reveal>
      <SectionHeading eyebrow="Contact" title={contact.heading} id="contact-title" />
      <p class="lead">{contact.intro}</p>
      <a class="btn contact__primary" href="mailto:bentjacobs01@gmail.com">
        <Icon name="mail" size={18} />
        Email me
      </a>
    </div>

    <ul class="contact__links" data-reveal style="--reveal-delay: 100ms">
      {contact.links.map((link) => (
        <li>
          <a
            href={link.href}
            {...(link.external
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <span class="contact__icon"><Icon name={link.icon} size={20} /></span>
            <span class="contact__text">
              <span class="contact__label">{link.label}</span>
              <span class="contact__value">{link.value}</span>
            </span>
            <span class="contact__chev" aria-hidden="true">
              <Icon name="arrow-up-right" size={16} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 10vw, 8rem);
    align-items: start;
  }
  .contact__intro .lead {
    max-width: 40ch;
  }
  .contact__primary {
    margin-top: var(--space-md);
    --btn-bg: #282721;
    --btn-fg: #fff8ed;
  }
  .contact__links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .contact__links a {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: 1.15rem 0;
    border-radius: 0;
    border-bottom: var(--border-w) solid currentColor;
    background: transparent;
    transition: transform 0.2s var(--ease);
  }
  .contact__links a:hover {
    transform: translateX(5px);
  }
  .contact__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 50%;
    border: 1px solid currentColor;
  }
  .contact__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .contact__label {
    font-size: var(--step--1);
    opacity: 0.65;
  }
  .contact__value {
    font-family: var(--font-heading);
    font-weight: 500;
    color: inherit;
    overflow-wrap: anywhere;
  }
  .contact__chev {
    margin-left: auto;
    opacity: 0.6;
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .contact__links a:hover .contact__chev {
    color: inherit;
    transform: translate(2px, -2px);
  }

  @media (max-width: 760px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
  :global(#contact) {
    color: #fff8ed;
    background: #ad553f;
  }
  :global(#contact)::before { display: none; }
  :global(#contact .eyebrow) { color: #f5d5a3; }
  :global(#contact .lead) { color: rgba(255, 248, 237, 0.78); }
</style>
