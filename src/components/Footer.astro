---
import { hero, footer, contact } from '../data/portfolio';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const socials = contact.links.filter((l) => l.icon === 'github' || l.icon === 'linkedin');
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__name">{hero.name}</span>
      <p class="footer__built">{footer.builtWith}</p>
    </div>

    <div class="footer__right">
      <ul class="footer__socials">
        {socials.map((s) => (
          <li>
            <a
              href={s.href}
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))}
        <li>
          <a href="mailto:bentjacobs01@gmail.com" aria-label="Email">
            <Icon name="mail" size={18} />
          </a>
        </li>
      </ul>

      <!-- 🚴 Tiny bike: triggers the same cycling easter egg as the Konami code. -->
      <button
        id="bike-trigger"
        class="footer__bike"
        type="button"
        aria-label="Take a victory lap"
        title="Go on, click me 🚴"
      >
        <Icon name="bike" size={18} />
      </button>
    </div>
  </div>

  <p class="footer__copy container">
    © {year} {hero.name}. All rights reserved.
  </p>
</footer>

<style>
  .footer {
    border-top: var(--border-w) solid var(--border);
    padding-block: var(--space-lg) var(--space-md);
    background: var(--bg);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }
  .footer__name {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--step-2);
  }
  .footer__built {
    color: var(--text-dim);
    font-size: var(--step--1);
    margin-top: 0.25rem;
  }
  .footer__right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .footer__socials {
    display: flex;
    gap: 0.4rem;
  }
  .footer__socials a,
  .footer__bike {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: var(--border-w) solid var(--border);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      transform 0.2s var(--ease);
  }
  .footer__socials a:hover {
    color: var(--accent-2);
    border-color: var(--accent-2);
    transform: translateY(-2px);
  }
  .footer__bike:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .footer__copy {
    color: var(--text-dim);
    font-size: var(--step--1);
    margin-top: var(--space-md);
  }
</style>
