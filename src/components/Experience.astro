---
import { experience, leadership, leadershipBlurb } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---

<section class="section experience-section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <SectionHeading eyebrow="Where I've been" title="Experience" id="experience-title" />

    <ol class="jobs">
      {experience.map((job, i) => (
        <li class="job" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <div class="job__when">
            <span>{job.period}</span>
            <span>{job.location}</span>
          </div>
          <div class="job__main">
            <h3>{job.role}</h3>
            <p class="job__company">at {job.company}</p>
            <ul class="job__points">
              {job.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <aside class="volunteering" data-reveal aria-labelledby="volunteering-title">
      <header class="volunteering__intro">
        <div>
          <span class="eyebrow">Volunteering</span>
          <h3 id="volunteering-title">Community &amp; teamwork</h3>
        </div>
        <p>{leadershipBlurb}</p>
      </header>

      <ul class="volunteering__list">
        {leadership.map((item) => (
          <li>
            <strong>{item.role}</strong>
            <span class="volunteering__org">{item.org} · {item.location}</span>
            {item.note && <p>{item.note}</p>}
            <div class="volunteering__footer">
              <span class="volunteering__period">{item.period}</span>
              {item.link && (
                <a href={item.link} target="_blank" rel="noopener noreferrer">
                  {item.linkLabel ?? 'Visit website'} <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .experience-section {
    background: var(--bg-elev);
  }
  .experience-section::before { display: none; }
  .jobs {
    border-top: 1px solid var(--border-strong);
  }
  .job {
    display: grid;
    grid-template-columns: minmax(10rem, 0.42fr) minmax(0, 1.58fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2.25rem, 5vw, 4rem);
    border-bottom: 1px solid var(--border);
  }
  .job__when {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .job__when span:last-child { color: var(--text-dim); }
  .job__main h3 {
    font-size: var(--step-2);
  }
  .job__company {
    margin-top: 0.35rem;
    color: var(--accent);
    font-family: var(--font-heading);
    font-size: var(--step-1);
  }
  .job__points {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem 2.5rem;
    margin-top: 1.6rem;
  }
  .job__points li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .job__points li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .volunteering {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-strong);
  }
  .volunteering__intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    padding-bottom: var(--space-sm);
  }
  .volunteering__intro h3 {
    margin-top: 0.35rem;
    font-size: var(--step-1);
  }
  .volunteering__intro p {
    max-width: 48ch;
    color: var(--text-muted);
    font-size: 0.76rem;
  }
  .volunteering__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }
  .volunteering__list > li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
  }
  .volunteering__list > li + li { border-left: 1px solid var(--border); }
  .volunteering__list strong {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
  }
  .volunteering__org {
    color: var(--text-dim);
    font-size: 0.74rem;
  }
  .volunteering__list li p {
    max-width: 52ch;
    padding-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .volunteering__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding-top: 0.65rem;
  }
  .volunteering__period {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .volunteering__footer a {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--border-strong);
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .volunteering__footer a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  @media (max-width: 760px) {
    .job { grid-template-columns: 1fr; gap: 1.25rem; }
    .job__points { grid-template-columns: 1fr; }
    .volunteering__intro { align-items: start; flex-direction: column; gap: 0.5rem; }
  }
  @media (max-width: 620px) {
    .volunteering__list { grid-template-columns: 1fr; }
    .volunteering__list > li + li {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
