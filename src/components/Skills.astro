---
import { skills } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';

// Fill colour per group — keeps each card visually distinct.
// Kempen-tuned categorical set: pine, heather, clay, ochre.
// Each passes 3:1 against the card background in both themes.
const groupColors: Record<string, string> = {
  Salesforce: '#4f7a48',
  'Frontend & Mobile': '#7c6494',
  'Backend & Languages': '#a05a3c',
  'Tools & DevOps': '#a07d2e',
};
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeading eyebrow="What I work with" title="Skills" id="skills-title" />

    <p class="skills-note">
      These reflect my current working proficiency, but I’ve consistently picked up new tools on
      the job and enjoy doing so.
    </p>

    <div class="skills">
      {skills.map((group, i) => (
        <article
          class="skill-card"
          data-reveal
          style={`--reveal-delay: ${i * 80}ms; --bar: ${groupColors[group.name] ?? 'var(--accent)'}`}
        >
          <header>
            <h3>{group.name}</h3>
            <p>{group.blurb}</p>
          </header>
          <ul class="meters">
            {group.items.map((item) => (
              <li class="meter">
                <span class="meter__name">{item.name}</span>
                <div
                  class="meter__track"
                  role="meter"
                  aria-valuenow={item.level}
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-label={`${item.name} proficiency`}
                >
                  <span class="meter__fill" style={`--level: ${item.level}%`}></span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-note {
    margin-bottom: var(--space-md);
    max-width: 48ch;
    font-size: var(--step--1);
    font-style: italic;
    color: var(--text-dim);
  }
  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-md);
  }
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-md);
    border-radius: var(--radius);
    border: var(--border-w) solid var(--border);
    background: var(--bg-elev);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .skill-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }
  .skill-card h3 {
    font-size: var(--step-1);
  }
  .skill-card header p {
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .meters {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: auto;
  }
  .meter {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .meter__name {
    flex: 0 0 42%;
    font-family: var(--font-heading);
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--text);
  }
  .meter__track {
    flex: 1;
    height: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--bar) 14%, transparent);
    overflow: hidden;
  }
  .meter__fill {
    display: block;
    height: 100%;
    width: var(--level);
    border-radius: inherit;
    background: var(--bar);
    /* Animate via scaleX so the fill grows in when the card reveals. */
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s var(--ease);
    transition-delay: calc(var(--reveal-delay, 0ms) + 120ms);
  }
  .skill-card.is-visible .meter__fill {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .meter__fill {
      transform: scaleX(1);
    }
  }
</style>
