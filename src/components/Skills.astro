---
import { skills } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="container skills-wrap">
    <div class="skills-intro">
      <SectionHeading eyebrow="What I work with" title="Skills" id="skills-title" />
      <p class="skills-note" data-reveal>
        These reflect my current working proficiency, though if something has documentation, I can usually get it working.
      </p>
    </div>

    <div class="skills">
      {skills.map((group, i) => (
        <article class="skill-row" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
          <span class="skill-row__number">0{i + 1}</span>
          <div>
            <h3>{group.name}</h3>
            <p>{group.blurb}</p>
          </div>
          <ul aria-label={`${group.name} technologies`}>
            {group.items.map((item) => <li>{item.name}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-wrap {
    display: grid;
    grid-template-columns: minmax(15rem, 0.65fr) minmax(0, 1.45fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: start;
  }
  .skills-intro {
    position: sticky;
    top: 7rem;
  }
  .skills-intro :global(.heading) {
    grid-template-columns: 1fr;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .skills-note {
    max-width: 32ch;
    color: var(--text-dim);
    font-size: var(--step--1);
    font-style: italic;
  }
  .skills {
    border-top: 1px solid var(--border-strong);
  }
  .skill-row {
    display: grid;
    grid-template-columns: 2.5rem minmax(10rem, 0.7fr) minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    padding-block: 1.65rem;
    border-bottom: 1px solid var(--border);
  }
  .skill-row__number {
    padding-top: 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  h3 {
    font-size: var(--step-1);
    line-height: 1.1;
  }
  .skill-row div p {
    margin-top: 0.5rem;
    max-width: 30ch;
    color: var(--text-dim);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .skill-row ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.7rem;
  }
  .skill-row li {
    position: relative;
    padding-right: 0.85rem;
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .skill-row li:not(:last-child)::after {
    content: '/';
    position: absolute;
    right: 0;
    color: var(--accent);
    opacity: 0.65;
  }
  @media (max-width: 820px) {
    .skills-wrap { grid-template-columns: 1fr; gap: 2rem; }
    .skills-intro { position: static; }
    .skills-note { max-width: 48ch; }
  }
  @media (max-width: 600px) {
    .skill-row { grid-template-columns: 2rem 1fr; }
    .skill-row ul { grid-column: 2; }
  }
</style>
