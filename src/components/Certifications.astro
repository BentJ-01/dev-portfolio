---
import { certifications } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
---

<section class="section section--tight" id="certifications" aria-labelledby="cert-title">
  <div class="container">
    <SectionHeading eyebrow="Credentials" title="Certifications" id="cert-title" />

    <div class="certs">
      {certifications.map((cert, i) => (
        <article class="cert" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          <div class="cert__badge" aria-hidden="true">
            <Icon name="spark" size={26} />
          </div>
          <div class="cert__body">
            <span class="cert__tag">AI agent credential</span>
            <h3>{cert.name}</h3>
            <p class="cert__issuer">{cert.issuer}</p>
            <p class="cert__note">{cert.note}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .certs {
    max-width: 52rem;
    margin-left: auto;
  }
  .cert {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding-block: var(--space-lg);
    border-block: var(--border-w) solid var(--border-strong);
    transition: transform 0.25s var(--ease);
  }
  .cert:hover {
    transform: translateX(4px);
  }
  .cert__badge {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    color: var(--accent);
    border: 2px solid var(--accent);
    transform: rotate(-7deg);
  }
  .cert__tag {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.35rem;
  }
  .cert__body h3 {
    font-size: var(--step-2);
  }
  .cert__issuer {
    color: var(--text-dim);
    font-size: var(--step--1);
    margin-top: 0.1rem;
  }
  .cert__note {
    margin-top: 0.6rem;
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  @media (max-width: 520px) {
    .cert { align-items: flex-start; }
    .cert__badge { width: 3.5rem; height: 3.5rem; }
  }
</style>
