---
// Scroll-progress indicator: a clean cycling "track" pinned to the bottom of the
// viewport. A slim accent bar fills left-to-right as you scroll, with a rider
// riding the leading edge and a KOM polka-dot flag at the finish.

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<div class="stage" id="stage" aria-hidden="true">
  <div class="stage__track"></div>
  <div class="stage__fill" id="stage-fill"></div>

  <!-- the rider, riding the leading edge of the fill -->
  <span class="stage__rider" id="stage-rider">
    <img src={asset('images/ridleynoah.png')} alt="" width="28" height="28" />
  </span>

  <!-- KOM polka-dot flag at the finish -->
  <div class="stage__summit" id="stage-summit">
    <!-- Fixed illustration colors: the KOM jersey is red dots on white, but
         softened to warm paper + muted brick so it sits in the Kempen palette. -->
    <svg class="stage__flag" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
      <rect x="3" y="2" width="1.6" height="20" rx="0.8" fill="currentColor" />
      <rect x="4.6" y="2.5" width="15" height="10" rx="1.2" fill="#f7f3e8" stroke="#b5402c" stroke-width="0.6" />
      <circle cx="8" cy="5.5" r="1.1" fill="#b5402c" />
      <circle cx="12.5" cy="5.5" r="1.1" fill="#b5402c" />
      <circle cx="17" cy="5.5" r="1.1" fill="#b5402c" />
      <circle cx="10.2" cy="8.5" r="1.1" fill="#b5402c" />
      <circle cx="14.7" cy="8.5" r="1.1" fill="#b5402c" />
    </svg>
  </div>
</div>

<style>
  .stage {
    position: fixed;
    inset: auto 0 0 0;
    height: 3px;
    z-index: 130;
    pointer-events: none;
  }
  .stage__track {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }
  .stage__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0;
    background: var(--accent);
  }
  .stage__rider {
    position: absolute;
    left: 0;
    bottom: 2px;
    line-height: 0;
    transform: translateX(-50%);
    transition: left 0.12s linear;
    will-change: left;
    opacity: 1;
    filter: drop-shadow(0 1px 1.5px rgba(0, 0, 0, 0.65));
  }
  .stage__rider img {
    display: block;
    width: 40px;
    height: auto;
  }

  .stage__summit {
    position: absolute;
    right: 4px;
    bottom: 4px;
    color: var(--accent);
    transform: scale(0);
    transform-origin: bottom right;
    opacity: 0;
    transition: transform 0.35s var(--ease), opacity 0.35s var(--ease);
  }
  .stage__summit.is-reached {
    transform: scale(1);
    opacity: 1;
  }
  .stage__summit.is-reached .stage__flag {
    animation: flag-pop 0.5s var(--ease);
  }
  @keyframes flag-pop {
    0% { transform: scale(0) rotate(-12deg); }
    60% { transform: scale(1.25) rotate(6deg); }
    100% { transform: scale(1) rotate(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage__rider {
      transition: none;
    }
    .stage__summit {
      transition: opacity 0.2s linear;
      transform: scale(1);
    }
    .stage__summit.is-reached .stage__flag {
      animation: none;
    }
  }
</style>

<script>
  const fill = document.getElementById('stage-fill');
  const rider = document.getElementById('stage-rider');
  const summit = document.getElementById('stage-summit');

  if (fill && rider && summit) {
    let reached = false;

    const update = () => {
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const p = max > 0 ? Math.min(Math.max(window.scrollY / max, 0), 1) : 0;

      fill.style.width = `${p * 100}%`;
      rider.style.left = `${p * 100}%`;

      const atSummit = p >= 0.99;
      if (atSummit !== reached) {
        reached = atSummit;
        summit.classList.toggle('is-reached', reached);
        rider.style.opacity = reached ? '0' : '1';
      }
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
