---
import { hero } from '../data/portfolio';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="eyebrow" data-reveal>
        <Icon name="spark" size={16} /> Available for developer roles
      </p>

      <h1 id="hero-name" data-reveal style="--reveal-delay: 50ms">{hero.name}</h1>

      <p class="hero__title" data-reveal style="--reveal-delay: 90ms">
        <span>{hero.title}</span>
        <span class="hero__angles">{hero.subtitle}</span>
      </p>

      <p class="hero__tagline" data-reveal style="--reveal-delay: 130ms">{hero.tagline}</p>

      <div class="hero__cta" data-reveal style="--reveal-delay: 170ms">
        <a class="btn" href={hero.cta.projects.href}>
          {hero.cta.projects.label}
          <Icon name="arrow-down" size={16} />
        </a>
        <a class="text-link" href={hero.cta.contact.href}>{hero.cta.contact.label} →</a>
        <a
          class="text-link"
          href={asset(hero.cta.cv.href)}
          download="Bent-Jacobs-CV.pdf"
          type="application/pdf"
        >
          <Icon name="download" size={15} /> {hero.cta.cv.label}
        </a>
      </div>
    </div>

    <div class="hero__media" data-reveal style="--reveal-delay: 100ms">
      <figure class="photo">
        <img
          src={asset(hero.photo)}
          alt={hero.photoAlt}
          width="440"
          height="520"
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 4rem);
    display: flex;
    align-items: center;
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.65fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7.5rem);
  }
  .hero__content {
    min-width: 0;
    width: 100%;
    max-width: 100%;
  }
  h1 {
    max-width: 11ch;
    font-size: var(--step-4);
    margin-top: 1rem;
  }
  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.45rem;
    font-family: var(--font-heading);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .hero__angles {
    font-family: var(--font-body);
    font-size: var(--step-0);
    color: var(--accent);
  }
  .hero__tagline {
    max-width: 48ch;
    margin-top: var(--space-md);
    color: var(--text-muted);
    font-size: var(--step-1);
    line-height: 1.55;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: var(--space-lg);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-block: 0.25rem;
    font-size: var(--step--1);
    font-weight: 600;
    border-bottom: 1px solid var(--border-strong);
  }
  .text-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .hero__media {
    justify-self: center;
  }
  .photo {
    position: relative;
    width: clamp(15.5rem, 24vw, 20rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    box-shadow: var(--shadow);
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(0.98);
  }
  @media (max-width: 900px) {
    .hero { min-height: auto; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { justify-self: start; margin-left: 1rem; }
  }
  @media (max-width: 540px) {
    .hero { padding-top: 3.5rem; }
    .hero__grid { gap: 4.5rem; }
    h1 {
      max-width: 100%;
      font-size: clamp(3.05rem, 14.3vw, 3.5rem);
      line-height: 0.96;
    }
    .hero__tagline {
      font-size: 1.05rem;
    }
    .hero__cta {
      width: 100%;
      max-width: 100%;
      align-items: flex-start;
    }
    .text-link:last-child {
      flex-basis: 100%;
      width: max-content;
    }
    .hero__media { justify-self: center; margin-left: 0; }
  }
</style>
