---
import { projects } from '../data/portfolio';
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';

const base = import.meta.env.BASE_URL;
const asset = (path: string) => `${base.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <SectionHeading eyebrow="Selected work" title="Projects" id="projects-title" />

    <div class="projects__toolbar" data-reveal>
      <p class="projects__note">
        <Icon name="spark" size={15} />
        Click any card for the full story, tech stack and links.
      </p>
      <div class="carousel__controls" aria-label="Project carousel controls">
        <button type="button" data-carousel-prev aria-label="Previous projects">
          <Icon name="arrow-left" size={17} />
        </button>
        <button type="button" data-carousel-next aria-label="Next projects">
          <Icon name="arrow-right" size={17} />
        </button>
      </div>
    </div>

    <div class="projects" data-project-carousel>
      {projects.map((project, i) => {
        const modalId = `project-modal-${i}`;
        const thumb = project.thumbnail ?? project.screenshots?.[0];
        return (
          <button
            type="button"
            class="card"
            data-reveal
            style={`--reveal-delay: ${i * 60}ms`}
            data-modal-target={modalId}
            aria-haspopup="dialog"
            aria-controls={modalId}
          >
            <span class="card__thumb">
              {thumb ? (
                <img src={asset(thumb)} alt="" loading="lazy" />
              ) : (
                <span class="card__monogram" aria-hidden="true">
                  {project.title.charAt(0)}
                </span>
              )}
              {project.featured && <span class="card__badge">Featured</span>}
            </span>

            <span class="card__body">
              <span class="card__title">{project.title}</span>
              <span class="card__stack">{project.tags.slice(0, 3).join(' · ')}</span>
              <span class="card__teaser">{project.description}</span>
            </span>

            <span class="card__hint">
              View details
              <Icon name="arrow-up-right" size={14} />
            </span>
          </button>
        );
      })}
    </div>

    {projects.map((project, i) => {
      const modalId = `project-modal-${i}`;
      const screenshots = project.screenshots ?? [];
      return (
        <dialog
          class:list={['pmodal', { 'pmodal--mockup': project.mockup }]}
          id={modalId}
          aria-labelledby={`${modalId}-title`}
        >
          <button type="button" class="pmodal__close" data-modal-close aria-label="Close project details">
            <Icon name="close" size={18} />
          </button>

          <div class="pmodal__inner">
            <div class="pmodal__content">
              {project.featured && <span class="pmodal__badge">Featured</span>}
              <h3 id={`${modalId}-title`}>{project.title}</h3>
              <p class="pmodal__desc">{project.description}</p>

              <ul class="pmodal__tags">
                {project.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>

              {project.link ? (
                <a class="btn pmodal__cta" href={project.link} target="_blank" rel="noopener noreferrer">
                  {project.linkLabel ?? 'Visit'}
                  <Icon name="arrow-up-right" size={16} />
                </a>
              ) : (
                <span class="pmodal__soon">Coming soon</span>
              )}
            </div>

            {project.mockup && (
              <div class="pmodal__mockup">
                {screenshots.length > 0 ? (
                  <div class="phone-strip" aria-label={`${project.title} app screenshots`}>
                    {screenshots.map((screenshot, screenshotIndex) => (
                      <div class="phone">
                        <span class="phone__notch" aria-hidden="true" />
                        <div class="phone__screen">
                          <img
                            src={asset(screenshot)}
                            alt={`${project.title} app screenshot ${screenshotIndex + 1}`}
                            loading="lazy"
                          />
                        </div>
                        <img
                          class="phone__preview"
                          src={asset(screenshot)}
                          alt=""
                          loading="lazy"
                          aria-hidden="true"
                        />
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="phone">
                    <span class="phone__notch" aria-hidden="true" />
                    <div class="phone__screen">
                      <span class="phone__placeholder">Screenshots coming soon</span>
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>
        </dialog>
      );
    })}
  </div>
</section>

<style>
  .projects__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: calc(-1 * var(--space-md));
    margin-bottom: var(--space-md);
  }
  .projects__note {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--step--1);
    color: var(--text-dim);
  }
  .projects__note :global(svg) {
    flex: none;
    color: var(--accent);
  }
  .carousel__controls {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .carousel__controls button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--border-w) solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-elev);
    color: var(--text);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease),
      opacity 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .carousel__controls button:hover:not(:disabled) {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  .carousel__controls button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .projects {
    display: flex;
    gap: 1rem;
    padding: 0.2rem 0.15rem 1rem;
    margin-inline: -0.15rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }
  .projects::-webkit-scrollbar {
    display: none;
  }

  /* ── Compact card ─────────────────────────────────────────────────────── */
  .card {
    flex: 0 0 calc((100% - 2rem) / 3);
    min-width: 0;
    scroll-snap-align: start;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.75rem 0.75rem 1rem;
    font: inherit;
    text-align: left;
    color: inherit;
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    cursor: pointer;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--shadow);
  }

  .card__thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 11;
    border-radius: calc(var(--radius) - 5px);
    border: var(--border-w) solid var(--border);
    background: var(--bg-elev-2);
    overflow: hidden;
  }
  .card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.35s var(--ease);
  }
  .card:hover .card__thumb img {
    transform: scale(1.025);
  }
  .card__monogram {
    font-family: var(--font-heading);
    font-size: clamp(4rem, 8vw, 7rem);
    font-weight: 400;
    line-height: 1;
    color: var(--accent);
    opacity: 0.7;
  }

  .card__badge {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font-family: var(--font-heading);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.22rem 0.55rem;
    border-radius: 5px;
    color: var(--accent-contrast);
    background: var(--accent);
  }

  .card__body {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    padding: 0.2rem 0.3rem 0;
  }
  .card__title {
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .card__stack {
    align-self: center;
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .card__teaser {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__hint {
    margin-top: -0.3rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-heading);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .card__hint :global(svg) {
    transition: transform 0.25s var(--ease);
  }
  .card:hover .card__hint :global(svg) {
    transform: translate(2px, -2px);
  }

  /* ── Detail popup ─────────────────────────────────────────────────────── */
  .pmodal {
    /* The global reset zeroes the UA's `dialog { margin: auto }`, which is
       what centers a modal dialog — restore it. */
    margin: auto;
    width: min(calc(100vw - 2rem), 34rem);
    max-height: min(85dvh, 46rem);
    padding: 0;
    border: var(--border-w) solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-elev);
    color: var(--text);
    box-shadow: var(--shadow);
    overflow: visible;
  }
  .pmodal--mockup {
    width: min(calc(100vw - 2rem), 64rem);
  }
  .pmodal::backdrop {
    background: rgba(28, 24, 17, 0.55);
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
  }
  .pmodal[open] {
    animation: pmodal-in 0.35s var(--ease);
  }
  .pmodal[open]::backdrop {
    animation: pmodal-backdrop-in 0.35s var(--ease);
  }
  @keyframes pmodal-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.97);
    }
  }
  @keyframes pmodal-backdrop-in {
    from {
      opacity: 0;
    }
  }

  /* Lock page scroll while a popup is open. */
  :global(html:has(dialog.pmodal[open])) {
    overflow: hidden;
  }

  .pmodal__inner {
    max-height: inherit;
    overflow-y: auto;
    padding: var(--space-lg);
  }
  .pmodal--mockup .pmodal__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pmodal__close {
    position: absolute;
    top: 0.9rem;
    right: 0.9rem;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    padding: 0;
    border-radius: var(--radius-sm);
    border: var(--border-w) solid var(--border);
    background: var(--bg-elev-2);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .pmodal__close:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .pmodal__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    /* Keep the title clear of the close button. */
    padding-right: 2rem;
  }
  .pmodal__content h3 {
    font-size: var(--step-2);
  }
  .pmodal__badge {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 5px;
    color: var(--accent-contrast);
    background: var(--accent);
  }
  .pmodal__desc {
    color: var(--text-muted);
    font-size: var(--step-0);
  }

  .pmodal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .pmodal__tags li {
    font-family: var(--font-heading);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.28rem 0.6rem;
    border-radius: 5px;
    border: var(--border-w) solid var(--border);
    color: var(--text-muted);
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .pmodal__tags li:hover {
    border-color: var(--accent-2);
    color: var(--accent-2);
  }

  .pmodal__cta {
    margin-top: var(--space-xs);
  }
  .pmodal__soon {
    font-family: var(--font-heading);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  .pmodal__mockup {
    display: flex;
    justify-content: flex-start;
    min-width: 0;
    width: 100%;
  }
  .phone-strip {
    display: flex;
    gap: 1.2rem;
    width: 100%;
    max-width: 100%;
    padding: 0.25rem 0.2rem 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--border-strong) transparent;
  }
  .phone {
    flex: 0 0 auto;
    position: relative;
    width: 13rem;
    aspect-ratio: 9 / 19;
    padding: 0.62rem;
    border-radius: 2rem;
    border: var(--border-w) solid var(--border-strong);
    background: var(--bg-elev-2);
    box-shadow: var(--shadow);
    scroll-snap-align: center;
  }
  .phone::after {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 18;
    pointer-events: none;
    background: rgba(28, 24, 17, 0);
    -webkit-backdrop-filter: blur(0);
    backdrop-filter: blur(0);
    opacity: 0;
    transition: opacity 0.2s var(--ease), background-color 0.2s var(--ease),
      backdrop-filter 0.2s var(--ease);
  }
  .phone:hover::after,
  .phone:focus-within::after {
    background: rgba(28, 24, 17, 0.68);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    opacity: 1;
  }
  .phone__notch {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    transform: translateX(-50%);
    width: 3.4rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--border-strong);
  }
  .phone__screen {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 1.38rem;
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    overflow: hidden;
  }
  .phone__screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .phone__preview {
    position: fixed;
    top: 50%;
    left: 50%;
    z-index: 19;
    width: min(26rem, calc((100dvh - 3rem) * 9 / 19), calc(100vw - 3rem));
    max-height: calc(100dvh - 3rem);
    aspect-ratio: 9 / 19;
    object-fit: contain;
    border-radius: 1.6rem;
    border: var(--border-w) solid var(--border-strong);
    background: var(--bg-elev-2);
    box-shadow: 0 28px 80px -24px rgba(0, 0, 0, 0.8);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transform: translate(-50%, -50%) scale(0.94);
    transition: opacity 0.2s var(--ease), transform 0.2s var(--ease),
      visibility 0.2s var(--ease);
  }
  .phone:hover .phone__preview,
  .phone:focus-within .phone__preview {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, -50%) scale(1);
  }
  .phone__placeholder {
    padding: 0 1rem;
    text-align: center;
    font-family: var(--font-heading);
    font-size: var(--step--1);
    color: var(--text-dim);
  }

  @media (max-width: 900px) {
    .card {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }

  @media (max-width: 600px) {
    .projects__toolbar {
      align-items: flex-end;
    }
    .projects__note {
      max-width: 25ch;
    }
    .card {
      flex-basis: min(84vw, 20rem);
    }
    .pmodal__inner {
      padding: var(--space-md);
    }
    .pmodal--mockup .pmodal__inner {
      align-items: stretch;
    }
    .pmodal__mockup {
      padding-top: var(--space-xs);
      justify-content: flex-start;
      width: 100%;
    }
    .phone-strip {
      max-width: 100%;
      width: 100%;
    }
    .phone {
      width: min(13rem, 72vw);
    }
    .pmodal__content h3 {
      font-size: var(--step-1);
    }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-project-carousel]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-carousel-prev]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-carousel-next]');

  if (carousel && previousButton && nextButton) {
    const updateCarouselControls = () => {
      const maxScroll = carousel.scrollWidth - carousel.clientWidth;
      previousButton.disabled = carousel.scrollLeft <= 2;
      nextButton.disabled = carousel.scrollLeft >= maxScroll - 2;
    };

    const moveCarousel = (direction: -1 | 1) => {
      const firstCard = carousel.querySelector<HTMLElement>('.card');
      if (!firstCard) return;

      const gap = Number.parseFloat(getComputedStyle(carousel).gap) || 0;
      const distance = firstCard.getBoundingClientRect().width + gap;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      carousel.scrollBy({
        left: distance * direction,
        behavior: reduceMotion ? 'auto' : 'smooth',
      });
    };

    previousButton.addEventListener('click', () => moveCarousel(-1));
    nextButton.addEventListener('click', () => moveCarousel(1));
    carousel.addEventListener('scroll', updateCarouselControls, { passive: true });
    window.addEventListener('resize', updateCarouselControls, { passive: true });
    updateCarouselControls();
  }

  // Each project card opens its matching <dialog>; native dialog handles
  // Esc, focus containment and returning focus to the card on close.
  document.querySelectorAll<HTMLButtonElement>('[data-modal-target]').forEach((card) => {
    card.addEventListener('click', () => {
      const dialog = document.getElementById(card.dataset.modalTarget ?? '');
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog.pmodal').forEach((dialog) => {
    // A click on the dialog element itself (not its children) is the backdrop.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.querySelector('[data-modal-close]')?.addEventListener('click', () => dialog.close());
  });
</script>
